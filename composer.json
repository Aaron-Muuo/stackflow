{
    "name": "stackflow/stackflow",
    "description": "Stackflow PHP — A lightweight, fast PHP framework with Android/Flutter-inspired widget-tree UI syntax.",
    "type": "project",
    "license": "MIT",
    "keywords": ["php", "framework", "stackflow", "widgets", "ui", "mvc"],
    "homepage": "https://github.com/Aaron-Muuo/stackflow",
    "authors": [
        {
            "name": "Aaron Muuo",
            "email": "aaronmuuo60@gmail.com",
            "role": "Creator"
        }
    ],
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6",
        "symfony/console": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "StackFlow\\": "framework/",
            "App\\": "app/"
        },
        "files": [
            "framework/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "phpro/grumphp": true
        }
    },
    "scripts": {
        "serve": "php stackflow serve",
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
